From a58534e8cf86ed5f3cb87ee9e42eda31b2ab7f5b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 11 Oct 2026 23:29:41 +0000
Subject: [PATCH 2/2] build(issue-87): D4 compile the bundled SQLite without
 allocator statistics

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WkCYCfQN5ESKshajCzXndN
---
 .cargo/config.toml | 5 +++++
 1 file changed, 5 insertions(+)
 create mode 100644 .cargo/config.toml

diff --git a/.cargo/config.toml b/.cargo/config.toml
new file mode 100644
index 0000000..b9b81bb
--- /dev/null
+++ b/.cargo/config.toml
@@ -0,0 +1,5 @@
+[env]
+# The bundled SQLite (libsqlite3-sys) otherwise takes one process-global mutex
+# on every allocation and free to keep memory statistics, which rrx never
+# reads. Under parallel load that mutex blocks Tokio workers (Issue #87, D4).
+LIBSQLITE3_FLAGS = "-DSQLITE_DEFAULT_MEMSTATUS=0"
-- 
2.43.0

